  rollbackVerification       String               @default("")
  rollbackUnavailable        Boolean              @default(false)
  rollbackAcknowledgement    String               @default("")
  rollbackAcknowledgedBy     String               @default("")
  plannedWindow              String               @default("")
  approvedBy                 String               @default("")
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  releaseCandidate ReleaseCandidate  @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  checks           DeploymentCheck[]
  deployments      DeploymentRecord[]
  approvals        ReleaseApproval[]

  @@index([releaseCandidateId])
  @@index([status])
}

model DeploymentCheck {
  id               String                 @id @default(cuid())
  deploymentPlanId String
  phase            DeploymentCheckPhase
  name             String
  description      String                 @default("")
  required         Boolean                @default(true)
  status           DeploymentCheckStatus  @default(PENDING)
  waiverRationale  String                 @default("")
  evidenceId       String                 @default("")
  completedBy      String                 @default("")
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  plan DeploymentPlan @relation(fields: [deploymentPlanId], references: [id], onDelete: Cascade)

  @@index([deploymentPlanId])
  @@index([phase])
}

model OperationalReadinessAssessment {
  id                 String   @id @default(cuid())
  releaseCandidateId String   @unique
  summary            String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  releaseCandidate ReleaseCandidate          @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  areas            OperationalReadinessArea[]
}

model OperationalReadinessArea {
  id            String          @id @default(cuid())
  assessmentId  String
  area          OperationalArea
  rating        SignalLevel     @default(LOW)
  relevant      Boolean         @default(true)
  notes         String          @default("")
  updatedAt     DateTime        @updatedAt

  assessment OperationalReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, area])
}

model ReleaseApproval {
  id                    String    @id @default(cuid())
  productId             String
  approvalId            String
  releaseCandidateId    String
  deploymentPlanId      String?
  deploymentPlanVersion Int       @default(0)
  evidenceFingerprint   String
  riskState             String    @default("")
  stale                 Boolean   @default(false)
  staleReason           String    @default("")
  staleFlaggedAt        DateTime?
  createdAt             DateTime  @default(now())

  approval         Approval          @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  releaseCandidate ReleaseCandidate  @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  deploymentPlan   DeploymentPlan?   @relation(fields: [deploymentPlanId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([releaseCandidateId])
  @@index([approvalId])
}

model DeploymentRecord {
  id                  String                 @id @default(cuid())
  releaseCandidateId  String
  deploymentPlanId    String?
  environment         String                 @default("")
  status              DeploymentRecordStatus
  deployedVersion     String                 @default("")
  deployedCommitSha   String                 @default("")
  startedAt           DateTime?
  completedAt         DateTime?
  performedBy         String                 @default("")
  externalReference   String                 @default("")
  notes               String                 @default("")
  reason              String                 @default("")
  demo                Boolean                @default(false)
  createdAt           DateTime               @default(now())

  releaseCandidate ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  deploymentPlan   DeploymentPlan?  @relation(fields: [deploymentPlanId], references: [id], onDelete: SetNull)
  issues           ReleaseIssue[]

  @@index([releaseCandidateId])
  @@index([status])
}

model ReleaseIssue {
  id                  String               @id @default(cuid())
  releaseCandidateId  String
  deploymentRecordId  String?
  severity            ReleaseIssueSeverity
  category            ReleaseIssueCategory
  description         String
  status              ReleaseIssueStatus   @default(OPEN)
  detectedAt          DateTime             @default(now())
  resolvedAt          DateTime?

  releaseCandidate ReleaseCandidate  @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  deployment       DeploymentRecord? @relation(fields: [deploymentRecordId], references: [id], onDelete: SetNull)

  @@index([releaseCandidateId])
  @@index([status])
  @@index([severity])
}

model ReleaseOutcome {
  id                    String   @id @default(cuid())
  releaseCandidateId    String   @unique
  deploymentSuccessful  Boolean  @default(false)
  rollbackRequired      Boolean  @default(false)
  summary               String   @default("")
  observedAt            DateTime @default(now())

  releaseCandidate ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
}

model OutcomeObservation {
  id                  String    @id @default(cuid())
  productId           String
  productOutcomeId    String
  releaseCandidateId  String?
  measure             String
  value               String
  unit                String    @default("")
  source              String    @default("HUMAN")
  evidenceReference   String    @default("")
  observedAt          DateTime  @default(now())
  recordedBy          String    @default("")
  notes               String    @default("")
  demo                Boolean   @default(false)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  outcome          ProductOutcome    @relation(fields: [productOutcomeId], references: [id], onDelete: Cascade)
  releaseCandidate ReleaseCandidate? @relation(fields: [releaseCandidateId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productOutcomeId])
  @@index([releaseCandidateId])
}

model LearningRecord {
  id                  String           @id @default(cuid())
  productId           String
  releaseCandidateId  String?
  productOutcomeId    String?
  observation         String
  interpretation      String           @default("")
  decision            LearningDecision
  createdBy           String           @default("")
  createdAt           DateTime         @default(now())

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  releaseCandidate ReleaseCandidate? @relation(fields: [releaseCandidateId], references: [id], onDelete: SetNull)
  outcome          ProductOutcome?   @relation(fields: [productOutcomeId], references: [id], onDelete: SetNull)
  proposals        LearningProposal[]

  @@index([productId])
  @@index([releaseCandidateId])
}

model LearningProposal {
  id               String                 @id @default(cuid())
  learningRecordId String
  productId        String
  kind             LearningProposalKind
  title            String
  description      String                 @default("")
  status           LearningProposalStatus @default(PROPOSED)
  createdRecordId  String                 @default("")
  confirmedBy      String                 @default("")
  confirmedAt      DateTime?
  createdAt        DateTime               @default(now())

  learningRecord LearningRecord @relation(fields: [learningRecordId], references: [id], onDelete: Cascade)

  @@index([learningRecordId])
  @@index([productId])
  @@index([status])
}

enum RequirementSourceKind {
  PASTED_TEXT
  UPLOADED_DOCUMENT
}

enum RequirementSourceStatus {
  ACTIVE
  SUPERSEDED
  EXTRACTION_FAILED
}

enum SourceRequirementKind {
  BUSINESS
  FUNCTIONAL
  NON_FUNCTIONAL
  SECURITY
  REGULATORY
  DATA
  INTEGRATION
  TECHNICAL_CONSTRAINT
  USER_EXPERIENCE
  OPERATIONAL
  UNKNOWN
}

enum InterpretationConfidence {
  HIGH
  MEDIUM
  LOW
  UNCERTAIN
}

enum RequirementConfirmation {
  UNREVIEWED
  CONFIRMED
  NEEDS_CHANGE
  REJECTED
}

enum RequirementDisposition {
  UNSET
  IN_SCOPE
  OUT_OF_SCOPE
  DEFERRED
  DUPLICATE
  SUPERSEDED
  NOT_A_REQUIREMENT
}

enum IntakeFindingType {
  AMBIGUOUS
  INCOMPLETE
  CONFLICT
  DUPLICATE
  MISSING_ACCEPTANCE_CRITERIA
  MISSING_OUTCOME
  UNCONFIRMED_ASSUMPTION
  MISSING_ACTOR
  MISSING_BUSINESS_RULE
  UNTESTABLE
  SECURITY_QUESTION
  NFR_GAP
  DEPENDENCY
  OTHER
}

enum IntakeFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum IntakeFindingStatus {
  OPEN
  ADDRESSED
  DISMISSED
}

enum IntakeQuestionPriority {
  HIGH
  MEDIUM
  LOW
}

enum IntakeQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

enum IntakeAnalysisStatus {
  CURRENT
  STALE
  FAILED
}

enum TraceTargetKind {
  PRODUCT_OUTCOME
  PRODUCT_CAPABILITY
  WORK_ITEM
  ACCEPTANCE_CRITERION
  NFR
}

enum TraceLinkProvenance {
  AI_PROPOSED
  HUMAN_CONFIRMED
}

model RequirementSource {
  id               String                  @id @default(cuid())
  productId        String
  kind             RequirementSourceKind
  title            String
  originalFilename String                  @default("")
  mediaType        String                  @default("")
  sourceText       String
  sourceHash       String
  storageName      String                  @default("")
  status           RequirementSourceStatus @default(ACTIVE)
  extractionNote   String                  @default("")
  pageCount        Int                     @default(0)
  createdBy        String                  @default("")
  createdAt        DateTime                @default(now())

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  requirements SourceRequirement[]
  analyses     AnalysisSource[]

  @@index([productId, status])
  @@index([sourceHash])
}

model RequirementsAnalysis {
  id               String               @id @default(cuid())
  productId        String
  version          Int
  status           IntakeAnalysisStatus @default(CURRENT)
  agentRunId       String               @default("")
  problem          String               @default("")
  value            String               @default("")
  users            Json                 @default("[]")
  needs            Json                 @default("[]")
  outcomes         Json                 @default("[]")
  assumptions      Json                 @default("[]")
  constraints      Json                 @default("[]")
  risks            Json                 @default("[]")
  scope            Json                 @default("[]")
  successMeasures  Json                 @default("[]")
  suggestedCapabilities Json            @default("[]")
  missingProblem   Boolean              @default(false)
  missingOutcome   Boolean              @default(false)
  createdAt        DateTime             @default(now())

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sources      AnalysisSource[]
  requirements SourceRequirement[]
  findings     RequirementFinding[]
  questions    IntakeQuestion[]

  @@unique([productId, version])
  @@index([productId, status])
}

model AnalysisSource {
  id         String @id @default(cuid())
  analysisId String
  sourceId   String
  sourceHash String

  analysis RequirementsAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  source   RequirementSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([analysisId, sourceId])
  @@index([sourceId])
}

model SourceRequirement {
  id                      String                   @id @default(cuid())
  productId               String
  sourceId                String
  analysisId              String
  identifier              String                   @default("")
  sourceText              String
  sectionHeading          String                   @default("")
  pageNumber              Int?
  blockIndex              Int                      @default(0)
  requirementType         SourceRequirementKind    @default(UNKNOWN)
  interpretation          String                   @default("")
  confirmedInterpretation String                   @default("")
  confidence              InterpretationConfidence @default(UNCERTAIN)
  confirmation            RequirementConfirmation  @default(UNREVIEWED)
  confirmedBy             String                   @default("")
  confirmedAt             DateTime?
  disposition             RequirementDisposition   @default(UNSET)
  dispositionReason       String                   @default("")
  dispositionBy           String                   @default("")
  suggestedCapability     String                   @default("")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  source   RequirementSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  analysis RequirementsAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  findingLinks FindingSourceLink[]
  questionLinks IntakeQuestionLink[]
  traces   RequirementTraceLink[]

  @@index([productId])
  @@index([sourceId])
  @@index([analysisId])
  @@index([confirmation])
}

model RequirementFinding {
  id          String                @id @default(cuid())
  productId   String
  analysisId  String
  findingType IntakeFindingType
  severity    IntakeFindingSeverity
  status      IntakeFindingStatus   @default(OPEN)
  title       String
  explanation String
  gapNote     String                @default("")
  createdAt   DateTime              @default(now())

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  analysis RequirementsAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  links    FindingSourceLink[]

  @@index([productId, status])
  @@index([analysisId])
}

model FindingSourceLink {
  id                  String  @id @default(cuid())
  findingId           String
  sourceRequirementId String?

  finding           RequirementFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  sourceRequirement SourceRequirement? @relation(fields: [sourceRequirementId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([sourceRequirementId])
}

model IntakeQuestion {
  id         String                 @id @default(cuid())
  productId  String
  analysisId String
  question   String
  reason     String                 @default("")
  priority   IntakeQuestionPriority @default(MEDIUM)
  status     IntakeQuestionStatus   @default(OPEN)
  answer     String                 @default("")
  answeredBy String                 @default("")
  answeredAt DateTime?
  createdAt  DateTime               @default(now())

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  analysis RequirementsAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  links    IntakeQuestionLink[]

  @@index([productId, status])
  @@index([analysisId])
  @@index([priority])
}

model IntakeQuestionLink {
  id                  String @id @default(cuid())
  questionId          String
  sourceRequirementId String

  question          IntakeQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceRequirement SourceRequirement @relation(fields: [sourceRequirementId], references: [id], onDelete: Cascade)

  @@unique([questionId, sourceRequirementId])
  @@index([sourceRequirementId])
}

model AiSelection {
  id        String   @id
  provider  String
  model     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model AiSelectionChange {
  id          String   @id @default(cuid())
  description String
  actor       String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AiProviderCredential {
  provider            String   @id
  encryptedCredential String
  encryptionIv        String
  authTag             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AiProviderConnectionCheck {
  provider  String   @id
  model     String
  outcome   String
  checkedAt DateTime @updatedAt
}

model RequirementTraceLink {
  id                  String              @id @default(cuid())
  productId           String
  sourceRequirementId String
  targetKind          TraceTargetKind
  targetId            String
  provenance          TraceLinkProvenance
  createdBy           String              @default("")
  createdAt           DateTime            @default(now())

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceRequirement SourceRequirement @relation(fields: [sourceRequirementId], references: [id], onDelete: Cascade)

  @@unique([sourceRequirementId, targetKind, targetId])
  @@index([productId])
  @@index([targetId])
}
