// AI Product Factory domain model.
// Modules own these entities through repositories. UI code does not query Prisma directly.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProductStage {
  EXPLORE
  DEFINE
  BUILD
  PROVE
  SHIP
  LEARN
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  TASK
  DEFECT
}

enum WorkItemStatus {
  DRAFT
  READY
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AcceptanceCriterionStatus {
  PENDING
  PASSED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  description      String
  vision           String
  problemStatement String
  targetUsers      String
  status           ProductStatus @default(DRAFT)
  currentStage     ProductStage  @default(EXPLORE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workItems         WorkItem[]
  decisions         Decision[]
  approvals         Approval[]
  activities        Activity[]
  agentRuns         AgentRun[]
  discoverySessions DiscoverySession[]
  productBriefs     ProductBrief[]
  definition        ProductDefinition?
  definitionProposals DefinitionProposal[]
  outcomes          ProductOutcome[]
  capabilities      ProductCapability[]
  slices            ProductSlice[]
  nonFunctionalRequirements NonFunctionalRequirement[]
  requirementQuestions RequirementQuestion[]
  requirementAssumptions RequirementAssumption[]

  @@index([status])
  @@index([updatedAt])
}

model WorkItem {
  id          String         @id @default(cuid())
  productId   String
  parentId    String?
  title       String
  description String         @default("")
  type        WorkItemType
  status      WorkItemStatus @default(DRAFT)
  stage       ProductStage   @default(EXPLORE)
  priority    Priority       @default(MEDIUM)
  capabilityId String?
  sliceId      String?
  provenance   WorkItemProvenance @default(HUMAN_CREATED)
  persona      String             @default("")
  userNeed     String             @default("")
  userValue    String             @default("")
  priorityAssigned Boolean        @default(false)
  dependenciesIdentified Boolean  @default(false)
  assumptionsNoted Boolean        @default(false)
  humanLocked  Boolean            @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent     WorkItem?  @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   WorkItem[] @relation("WorkItemHierarchy")
  capability ProductCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  slice      ProductSlice?      @relation(fields: [sliceId], references: [id], onDelete: SetNull)

  acceptanceCriteria AcceptanceCriterion[]
  requirementQuestions RequirementQuestion[]
  requirementAssumptions RequirementAssumption[]
  decisions          Decision[]
  approvals          Approval[]
  activities         Activity[]
  agentRuns          AgentRun[]
  dependencies       WorkItemDependency[] @relation("DependentItem")
  dependents         WorkItemDependency[] @relation("DependencyTarget")

  @@index([productId])
  @@index([parentId])
  @@index([status])
  @@index([type])
  @@index([updatedAt])
  @@index([capabilityId])
  @@index([sliceId])
}

model WorkItemDependency {
  id          String   @id @default(cuid())
  workItemId  String
  dependsOnId String
  createdAt   DateTime @default(now())

  workItem  WorkItem @relation("DependentItem", fields: [workItemId], references: [id], onDelete: Cascade)
  dependsOn WorkItem @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([workItemId, dependsOnId])
  @@index([dependsOnId])
}

model AcceptanceCriterion {
  id          String                    @id @default(cuid())
  workItemId  String
  description String
  status      AcceptanceCriterionStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model Decision {
  id            String   @id @default(cuid())
  productId     String
  workItemId    String?
  title         String
  description   String
  decision      String
  reason        String
  decisionMaker String
  createdAt     DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([workItemId])
}

model Approval {
  id           String         @id @default(cuid())
  productId    String
  workItemId   String?
  approvalType String
  status       ApprovalStatus @default(PENDING)
  requestedAt  DateTime       @default(now())
  resolvedAt   DateTime?
  approvedBy   String?
  comments     String         @default("")

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
  @@index([workItemId])
  @@index([requestedAt])
}

model Activity {
  id          String   @id @default(cuid())
  productId   String
  workItemId  String?
  type        String
  description String
  actor       String
  createdAt   DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([workItemId])
  @@index([type])
  @@index([actor])
  @@index([createdAt])
}

model AgentRun {
  id            String         @id @default(cuid())
  productId     String
  workItemId    String?
  agentType     String
  status        AgentRunStatus @default(PENDING)
  input         Json?
  output        Json?
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int?
  estimatedCost Decimal?       @db.Decimal(12, 4)
  createdAt     DateTime       @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workItemId])
  @@index([agentType])
  @@index([status])
}

enum DiscoveryStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum DiscoveryMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProductBriefStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum SignalLevel {
  LOW
  MEDIUM
  HIGH
}

enum AssumptionStatus {
  UNVALIDATED
  VALIDATED
  INVALIDATED
}

enum AssumptionImpact {
  LOW
  MEDIUM
  HIGH
}

enum BriefOrigin {
  AI_PROPOSAL
  HUMAN_CONFIRMED
  UNRESOLVED
}

model DiscoverySession {
  id               String          @id @default(cuid())
  productId        String          @unique
  status           DiscoveryStatus @default(NOT_STARTED)
  initialIdea      String          @default("")
  optionalContext  String          @default("")
  knownConstraints String          @default("")
  knownUsers       String          @default("")
  desiredOutcome   String          @default("")
  seededDemo       Boolean         @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  briefs   ProductBrief[]

  @@index([status])
}

model DiscoveryMessage {
  id        String               @id @default(cuid())
  sessionId String
  role      DiscoveryMessageRole
  content   String
  createdAt DateTime             @default(now())

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ProductBrief {
  id               String             @id @default(cuid())
  productId        String
  sessionId        String?
  version          Int
  problemStatement String             @default("")
  productVision    String             @default("")
  valueProposition String             @default("")
  // Ordered notes. Each item is { id, text, origin }.
  // Assumptions are a separate entity because they have their own lifecycle.
  targetUsers      Json               @default("[]")
  userNeeds        Json               @default("[]")
  desiredOutcomes  Json               @default("[]")
  constraints      Json               @default("[]")
  risks            Json               @default("[]")
  openQuestions    Json               @default("[]")
  inScope          Json               @default("[]")
  outOfScope       Json               @default("[]")
  successMeasures  Json               @default("[]")
  // Origin of the three prose fields: problemStatement, productVision, valueProposition.
  fieldOrigins     Json               @default("{}")
  problemClarity   SignalLevel        @default(LOW)
  userClarity      SignalLevel        @default(LOW)
  outcomeClarity   SignalLevel        @default(LOW)
  scopeClarity     SignalLevel        @default(LOW)
  riskClarity      SignalLevel        @default(LOW)
  readyForReview   Boolean            @default(false)
  readinessReason  String             @default("")
  status           ProductBriefStatus @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  session     DiscoverySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assumptions Assumption[]
  outcomes    ProductOutcome[]

  @@unique([productId, version])
  @@index([productId])
  @@index([sessionId])
  @@index([status])
}

model Assumption {
  id          String           @id @default(cuid())
  briefId     String
  description String
  impact      AssumptionImpact @default(MEDIUM)
  confidence  SignalLevel      @default(LOW)
  status      AssumptionStatus @default(UNVALIDATED)
  origin      BriefOrigin      @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brief ProductBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([status])
  @@index([impact])
}

enum OutcomeStatus {
  PROPOSED
  CONFIRMED
  ACHIEVED
  RETIRED
}

enum CapabilityStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum SliceStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum NfrCategory {
  PERFORMANCE
  SECURITY
  PRIVACY
  ACCESSIBILITY
  AVAILABILITY
  SCALABILITY
  AUDITABILITY
  COMPLIANCE
  USABILITY
  OTHER
}

enum RequirementItemStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum DefinitionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum ProposalStatus {
  OPEN
  PARTIALLY_COMMITTED
  COMMITTED
  REJECTED
  SUPERSEDED
}

enum WorkItemProvenance {
  HUMAN_CREATED
  AI_PROPOSAL
  AI_ACCEPTED
}

enum RequirementOrigin {
  AI_PROPOSAL
  HUMAN_CONFIRMED
  HUMAN_CREATED
}

model ProductDefinition {
  id            String           @id @default(cuid())
  productId     String           @unique
  status        DefinitionStatus @default(NOT_STARTED)
  seededDemo    Boolean          @default(false)
  reviewSummary String           @default("")
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DefinitionProposal {
  id         String         @id @default(cuid())
  productId  String
  agentRunId String?
  status     ProposalStatus @default(OPEN)
  summary    String         @default("")
  payload    Json
  seededDemo Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([status])
}

model ProductOutcome {
  id             String        @id @default(cuid())
  productId      String
  title          String
  description    String        @default("")
  successMeasure String        @default("")
  targetValue    String        @default("")
  status         OutcomeStatus @default(PROPOSED)
  sourceBriefId  String?
  humanLocked    Boolean       @default(false)
  origin         RequirementOrigin @default(AI_PROPOSAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceBrief  ProductBrief?       @relation(fields: [sourceBriefId], references: [id], onDelete: SetNull)
  capabilities ProductCapability[]

  @@index([productId])
  @@index([status])
  @@index([sourceBriefId])
}

model ProductCapability {
  id          String           @id @default(cuid())
  productId   String
  outcomeId   String
  name        String
  description String           @default("")
  status      CapabilityStatus @default(PROPOSED)
  priority    Priority         @default(MEDIUM)
  humanLocked Boolean          @default(false)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  outcome  ProductOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@index([productId])
  @@index([outcomeId])
  @@index([status])
}

model ProductSlice {
  id          String      @id @default(cuid())
  productId   String
  name        String
  description String      @default("")
  rationale   String      @default("")
  status      SliceStatus @default(PROPOSED)
  humanLocked Boolean     @default(false)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@index([productId])
  @@index([status])
}

model NonFunctionalRequirement {
  id          String                @id @default(cuid())
  productId   String
  category    NfrCategory
  title       String
  description String                @default("")
  measure     String                @default("")
  status      RequirementItemStatus @default(PROPOSED)
  source      RequirementOrigin     @default(AI_PROPOSAL)
  humanLocked Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([category])
  @@index([status])
}

model RequirementQuestion {
  id          String           @id @default(cuid())
  productId   String
  workItemId  String?
  question    String
  reason      String           @default("")
  impact      AssumptionImpact @default(MEDIUM)
  status      QuestionStatus   @default(OPEN)
  answer      String           @default("")
  answeredBy  String           @default("")
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workItemId])
  @@index([status])
  @@index([impact])
}

model RequirementAssumption {
  id          String           @id @default(cuid())
  productId   String
  workItemId  String?
  description String
  impact      AssumptionImpact @default(MEDIUM)
  confidence  SignalLevel      @default(LOW)
  status      AssumptionStatus @default(UNVALIDATED)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workItemId])
  @@index([status])
  @@index([impact])
}
