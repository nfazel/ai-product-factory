model ReleaseCandidate {
  id                   String                 @id @default(cuid())
  productId            String
  productSliceId       String
  version              String
  name                 String
  description          String                 @default("")
  status               ReleaseCandidateStatus @default(DRAFT)
  sourceCommitSummary  Json                   @default("[]")
  evidenceFingerprint  String                 @default("")
  releaseNotes         String                 @default("")
