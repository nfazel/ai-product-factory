// AI Product Factory domain model.
// Modules own these entities through repositories. UI code does not query Prisma directly.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProductStage {
  EXPLORE
  DEFINE
  BUILD
  PROVE
  SHIP
  LEARN
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  TASK
  DEFECT
}

enum WorkItemStatus {
  DRAFT
  READY
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AcceptanceCriterionStatus {
  PENDING
  PASSED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  description      String
  vision           String
  problemStatement String
  targetUsers      String
  status           ProductStatus @default(DRAFT)
  currentStage     ProductStage  @default(EXPLORE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workItems         WorkItem[]
  decisions         Decision[]
  approvals         Approval[]
  activities        Activity[]
  agentRuns         AgentRun[]
  discoverySessions DiscoverySession[]
  productBriefs     ProductBrief[]
  definition        ProductDefinition?
  definitionProposals DefinitionProposal[]
  outcomes          ProductOutcome[]
  capabilities      ProductCapability[]
  slices            ProductSlice[]
  nonFunctionalRequirements NonFunctionalRequirement[]
  requirementQuestions RequirementQuestion[]
  requirementAssumptions RequirementAssumption[]
  codebaseContext CodebaseContext?
  solutionArchitectures SolutionArchitecture[]
  architectureDecisions ArchitectureDecisionRecord[]
  architectureQuestions ArchitectureQuestion[]
  implementationPlans ImplementationPlan[]
  architectureProposals ArchitectureProposal[]
  governanceReviews EngineeringGovernanceReview[]
  codingPolicies CodingPolicy[]
  governanceProposals GovernanceProposal[]
  repositories Repository[]
  repositoryWorkspaces RepositoryWorkspace[]

  @@index([status])
  @@index([updatedAt])
}

model WorkItem {
  id          String         @id @default(cuid())
  productId   String
  parentId    String?
  title       String
  description String         @default("")
  type        WorkItemType
  status      WorkItemStatus @default(DRAFT)
  stage       ProductStage   @default(EXPLORE)
  priority    Priority       @default(MEDIUM)
  capabilityId String?
  sliceId      String?
  provenance   WorkItemProvenance @default(HUMAN_CREATED)
  persona      String             @default("")
  userNeed     String             @default("")
  userValue    String             @default("")
  priorityAssigned Boolean        @default(false)
  dependenciesIdentified Boolean  @default(false)
  assumptionsNoted Boolean        @default(false)
  humanLocked  Boolean            @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent     WorkItem?  @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   WorkItem[] @relation("WorkItemHierarchy")
  capability ProductCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  slice      ProductSlice?      @relation(fields: [sliceId], references: [id], onDelete: SetNull)

  acceptanceCriteria AcceptanceCriterion[]
  requirementQuestions RequirementQuestion[]
  requirementAssumptions RequirementAssumption[]
  componentTraces ComponentTrace[]
  implementationTasks ImplementationTask[]
  findingLinks       GovernanceFindingLink[]
  decisions          Decision[]
  approvals          Approval[]
  activities         Activity[]
  agentRuns          AgentRun[]
  dependencies       WorkItemDependency[] @relation("DependentItem")
  dependents         WorkItemDependency[] @relation("DependencyTarget")

  @@index([productId])
  @@index([parentId])
  @@index([status])
  @@index([type])
  @@index([updatedAt])
  @@index([capabilityId])
  @@index([sliceId])
}

model WorkItemDependency {
  id          String   @id @default(cuid())
  workItemId  String
  dependsOnId String
  createdAt   DateTime @default(now())

  workItem  WorkItem @relation("DependentItem", fields: [workItemId], references: [id], onDelete: Cascade)
  dependsOn WorkItem @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([workItemId, dependsOnId])
  @@index([dependsOnId])
}

model AcceptanceCriterion {
  id          String                    @id @default(cuid())
  workItemId  String
  description String
  status      AcceptanceCriterionStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model Decision {
  id            String   @id @default(cuid())
  productId     String
  workItemId    String?
  title         String
  description   String
  decision      String
  reason        String
  decisionMaker String
  createdAt     DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([workItemId])
}

model Approval {
  id           String         @id @default(cuid())
  productId    String
  workItemId   String?
  approvalType String
  status       ApprovalStatus @default(PENDING)
  requestedAt  DateTime       @default(now())
  resolvedAt   DateTime?
  approvedBy   String?
  comments     String         @default("")

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  codeChangeApprovals CodeChangeApproval[]

  @@index([status])
  @@index([productId])
  @@index([workItemId])
  @@index([requestedAt])
}

model Activity {
  id          String   @id @default(cuid())
  productId   String
  workItemId  String?
  type        String
  description String
  actor       String
  createdAt   DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([workItemId])
  @@index([type])
  @@index([actor])
  @@index([createdAt])
}

model AgentRun {
  id            String         @id @default(cuid())
  productId     String
  workItemId    String?
  agentType     String
  status        AgentRunStatus @default(PENDING)
  input         Json?
  output        Json?
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int?
  estimatedCost Decimal?       @db.Decimal(12, 4)
  createdAt     DateTime       @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workItemId])
  @@index([agentType])
  @@index([status])
}

enum DiscoveryStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum DiscoveryMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProductBriefStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum SignalLevel {
  LOW
  MEDIUM
  HIGH
}

enum AssumptionStatus {
  UNVALIDATED
  VALIDATED
  INVALIDATED
}

enum AssumptionImpact {
  LOW
  MEDIUM
  HIGH
}

enum BriefOrigin {
  AI_PROPOSAL
  HUMAN_CONFIRMED
  UNRESOLVED
}

model DiscoverySession {
  id               String          @id @default(cuid())
  productId        String          @unique
  status           DiscoveryStatus @default(NOT_STARTED)
  initialIdea      String          @default("")
  optionalContext  String          @default("")
  knownConstraints String          @default("")
  knownUsers       String          @default("")
  desiredOutcome   String          @default("")
  seededDemo       Boolean         @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  briefs   ProductBrief[]

  @@index([status])
}

model DiscoveryMessage {
  id        String               @id @default(cuid())
  sessionId String
  role      DiscoveryMessageRole
  content   String
  createdAt DateTime             @default(now())

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ProductBrief {
  id               String             @id @default(cuid())
  productId        String
  sessionId        String?
  version          Int
  problemStatement String             @default("")
  productVision    String             @default("")
  valueProposition String             @default("")
  // Ordered notes. Each item is { id, text, origin }.
  // Assumptions are a separate entity because they have their own lifecycle.
  targetUsers      Json               @default("[]")
  userNeeds        Json               @default("[]")
  desiredOutcomes  Json               @default("[]")
  constraints      Json               @default("[]")
  risks            Json               @default("[]")
  openQuestions    Json               @default("[]")
  inScope          Json               @default("[]")
  outOfScope       Json               @default("[]")
  successMeasures  Json               @default("[]")
  // Origin of the three prose fields: problemStatement, productVision, valueProposition.
  fieldOrigins     Json               @default("{}")
  problemClarity   SignalLevel        @default(LOW)
  userClarity      SignalLevel        @default(LOW)
  outcomeClarity   SignalLevel        @default(LOW)
  scopeClarity     SignalLevel        @default(LOW)
  riskClarity      SignalLevel        @default(LOW)
  readyForReview   Boolean            @default(false)
  readinessReason  String             @default("")
  status           ProductBriefStatus @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  session     DiscoverySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assumptions Assumption[]
  outcomes    ProductOutcome[]

  @@unique([productId, version])
  @@index([productId])
  @@index([sessionId])
  @@index([status])
}

model Assumption {
  id          String           @id @default(cuid())
  briefId     String
  description String
  impact      AssumptionImpact @default(MEDIUM)
  confidence  SignalLevel      @default(LOW)
  status      AssumptionStatus @default(UNVALIDATED)
  origin      BriefOrigin      @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brief ProductBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([status])
  @@index([impact])
}

enum OutcomeStatus {
  PROPOSED
  CONFIRMED
  ACHIEVED
  RETIRED
}

enum CapabilityStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum SliceStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum NfrCategory {
  PERFORMANCE
  SECURITY
  PRIVACY
  ACCESSIBILITY
  AVAILABILITY
  SCALABILITY
  AUDITABILITY
  COMPLIANCE
  USABILITY
  OTHER
}

enum RequirementItemStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum DefinitionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum ProposalStatus {
  OPEN
  PARTIALLY_COMMITTED
  COMMITTED
  REJECTED
  SUPERSEDED
}

enum WorkItemProvenance {
  HUMAN_CREATED
  AI_PROPOSAL
  AI_ACCEPTED
}

enum RequirementOrigin {
  AI_PROPOSAL
  HUMAN_CONFIRMED
  HUMAN_CREATED
}

model ProductDefinition {
  id            String           @id @default(cuid())
  productId     String           @unique
  status        DefinitionStatus @default(NOT_STARTED)
  seededDemo    Boolean          @default(false)
  reviewSummary String           @default("")
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DefinitionProposal {
  id         String         @id @default(cuid())
  productId  String
  agentRunId String?
  status     ProposalStatus @default(OPEN)
  summary    String         @default("")
  payload    Json
  seededDemo Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([status])
}

model ProductOutcome {
  id             String        @id @default(cuid())
  productId      String
  title          String
  description    String        @default("")
  successMeasure String        @default("")
  targetValue    String        @default("")
  status         OutcomeStatus @default(PROPOSED)
  sourceBriefId  String?
  humanLocked    Boolean       @default(false)
  origin         RequirementOrigin @default(AI_PROPOSAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceBrief  ProductBrief?       @relation(fields: [sourceBriefId], references: [id], onDelete: SetNull)
  capabilities ProductCapability[]

  @@index([productId])
  @@index([status])
  @@index([sourceBriefId])
}

model ProductCapability {
  id          String           @id @default(cuid())
  productId   String
  outcomeId   String
  name        String
  description String           @default("")
  status      CapabilityStatus @default(PROPOSED)
  priority    Priority         @default(MEDIUM)
  humanLocked Boolean          @default(false)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  outcome  ProductOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  componentTraces ComponentTrace[]

  @@index([productId])
  @@index([outcomeId])
  @@index([status])
}

model ProductSlice {
  id          String      @id @default(cuid())
  productId   String
  name        String
  description String      @default("")
  rationale   String      @default("")
  status      SliceStatus @default(PROPOSED)
  humanLocked Boolean     @default(false)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  solutionArchitectures SolutionArchitecture[]
  implementationPlans ImplementationPlan[]

  @@index([productId])
  @@index([status])
}

model NonFunctionalRequirement {
  id          String                @id @default(cuid())
  productId   String
  category    NfrCategory
  title       String
  description String                @default("")
  measure     String                @default("")
  status      RequirementItemStatus @default(PROPOSED)
  source      RequirementOrigin     @default(AI_PROPOSAL)
  humanLocked Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  coverages NfrCoverage[]
  componentTraces ComponentTrace[]
  findingLinks GovernanceFindingLink[]

  @@index([productId])
  @@index([category])
  @@index([status])
}

model RequirementQuestion {
  id          String           @id @default(cuid())
  productId   String
  workItemId  String?
  question    String
  reason      String           @default("")
  impact      AssumptionImpact @default(MEDIUM)
  status      QuestionStatus   @default(OPEN)
  answer      String           @default("")
  answeredBy  String           @default("")
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workItemId])
  @@index([status])
  @@index([impact])
}

model RequirementAssumption {
  id          String           @id @default(cuid())
  productId   String
  workItemId  String?
  description String
  impact      AssumptionImpact @default(MEDIUM)
  confidence  SignalLevel      @default(LOW)
  status      AssumptionStatus @default(UNVALIDATED)
  origin      RequirementOrigin @default(AI_PROPOSAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  findingLinks GovernanceFindingLink[]

  @@index([productId])
  @@index([workItemId])
  @@index([status])
  @@index([impact])
}

enum CodebaseSource {
  MANUAL
  DEMO
  LOCAL_ANALYSIS
  FUTURE_GITHUB
}

enum SystemKind {
  GREENFIELD
  EXISTING_SYSTEM
}

enum ArchitectureStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum ComponentType {
  USER_INTERFACE
  SERVICE
  API
  DATABASE
  QUEUE
  CACHE
  EXTERNAL_SYSTEM
  AI_SERVICE
  IDENTITY
  STORAGE
  OBSERVABILITY
  OTHER
}

enum RelationshipType {
  CALLS
  READS_FROM
  WRITES_TO
  PUBLISHES_TO
  SUBSCRIBES_TO
  AUTHENTICATES_WITH
  INTEGRATES_WITH
}

enum AdrStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum SecurityArea {
  AUTHENTICATION
  AUTHORISATION
  SENSITIVE_DATA
  ENCRYPTION
  SECRETS
  AUDITABILITY
  EXTERNAL_INTEGRATIONS
  DATA_RETENTION
  PRIVACY
  THREATS
  COMPLIANCE
}

enum SecurityClassification {
  INFORMATION
  CONCERN
  DECISION_REQUIRED
  BLOCKER
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum PlanStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum ImplementationTaskStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  CODE_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskComplexity {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

enum ArchitectureProposalKind {
  ARCHITECTURE
  IMPLEMENTATION_PLAN
}

model CodebaseContext {
  id                   String         @id @default(cuid())
  productId            String         @unique
  repositoryName       String         @default("")
  repositoryUrl        String         @default("")
  defaultBranch        String         @default("")
  systemKind           SystemKind     @default(GREENFIELD)
  languages            Json           @default("[]")
  frameworks           Json           @default("[]")
  databaseTechnologies Json           @default("[]")
  infrastructure       String         @default("")
  deploymentPlatform   String         @default("")
  architectureSummary  String         @default("")
  keyDirectories       Json           @default("[]")
  keyComponents        Json           @default("[]")
  knownIntegrations    Json           @default("[]")
  constraints          String         @default("")
  observations         String         @default("")
  source               CodebaseSource @default(MANUAL)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SolutionArchitecture {
  id                    String             @id @default(cuid())
  productId             String
  productSliceId        String?
  version               Int
  status                ArchitectureStatus @default(DRAFT)
  systemKind            SystemKind         @default(GREENFIELD)
  architectureStyle     String             @default("")
  summary               String             @default("")
  rationale             String             @default("")
  frontendApproach      String             @default("")
  backendApproach       String             @default("")
  dataApproach          String             @default("")
  integrationApproach   String             @default("")
  securityApproach      String             @default("")
  deploymentApproach    String             @default("")
  observabilityApproach String             @default("")
  seededDemo            Boolean            @default(false)
  humanLocked           Boolean            @default(false)
  reviewRequired        Boolean            @default(false)
  reviewReason          String             @default("")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  product       Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSlice  ProductSlice?               @relation(fields: [productSliceId], references: [id], onDelete: SetNull)
  components    ArchitectureComponent[]
  relationships ArchitectureRelationship[]
  decisions     ArchitectureDecisionRecord[]
  questions     ArchitectureQuestion[]
  findings      SecurityFinding[]
  dataEntities  DataEntity[]
  integrations  IntegrationDesign[]
  technologies  TechnologyChoice[]
  nfrCoverages  NfrCoverage[]
  plans         ImplementationPlan[]
  governanceReviews EngineeringGovernanceReview[]

  @@unique([productId, version])
  @@index([productId])
  @@index([status])
  @@index([productSliceId])
}

model ArchitectureComponent {
  id                     String        @id @default(cuid())
  solutionArchitectureId String
  name                   String
  type                   ComponentType
  description            String        @default("")
  responsibilities       String        @default("")
  technology             String        @default("")
  rationale              String        @default("")
  humanLocked            Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  architecture SolutionArchitecture         @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  outgoing     ArchitectureRelationship[]   @relation("RelationshipSource")
  incoming     ArchitectureRelationship[]   @relation("RelationshipTarget")
  traces       ComponentTrace[]
  nfrCoverages NfrCoverage[]
  taskLinks    ImplementationTaskComponent[]
  findingLinks GovernanceFindingLink[]
  threats      Threat[]

  @@index([solutionArchitectureId])
  @@index([type])
}

model ArchitectureRelationship {
  id                     String           @id @default(cuid())
  solutionArchitectureId String
  sourceComponentId      String
  targetComponentId      String
  relationshipType       RelationshipType
  description            String           @default("")
  createdAt              DateTime         @default(now())

  architecture    SolutionArchitecture  @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  sourceComponent ArchitectureComponent @relation("RelationshipSource", fields: [sourceComponentId], references: [id], onDelete: Cascade)
  targetComponent ArchitectureComponent @relation("RelationshipTarget", fields: [targetComponentId], references: [id], onDelete: Cascade)

  @@index([solutionArchitectureId])
  @@index([sourceComponentId])
  @@index([targetComponentId])
}

model ArchitectureDecisionRecord {
  id                     String    @id @default(cuid())
  productId              String
  solutionArchitectureId String
  title                  String
  context                String    @default("")
  decision               String    @default("")
  rationale              String    @default("")
  alternatives           String    @default("")
  consequences           String    @default("")
  status                 AdrStatus @default(PROPOSED)
  humanLocked            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  architecture SolutionArchitecture   @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  traces       ComponentTrace[]
  nfrCoverages NfrCoverage[]
  findingLinks GovernanceFindingLink[]

  @@index([productId])
  @@index([solutionArchitectureId])
  @@index([status])
}

model TechnologyChoice {
  id                     String   @id @default(cuid())
  solutionArchitectureId String
  choice                 String
  reason                 String   @default("")
  alternatives           String   @default("")
  tradeoffs              String   @default("")
  relevantConstraint     String   @default("")
  humanLocked            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)

  @@index([solutionArchitectureId])
}

model DataEntity {
  id                     String             @id @default(cuid())
  solutionArchitectureId String
  name                   String
  description            String             @default("")
  owner                  String             @default("")
  classification         DataClassification @default(INTERNAL)
  retention              String             @default("")
  relationships          String             @default("")
  externalSource         String             @default("")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)

  @@index([solutionArchitectureId])
}

model IntegrationDesign {
  id                       String               @id @default(cuid())
  solutionArchitectureId   String
  name                     String
  purpose                  String               @default("")
  direction                IntegrationDirection @default(OUTBOUND)
  protocol                 String               @default("")
  authenticationAssumption String               @default("")
  dataExchanged            String               @default("")
  failureConsiderations    String               @default("")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)

  @@index([solutionArchitectureId])
}

model SecurityFinding {
  id                     String                 @id @default(cuid())
  solutionArchitectureId String
  area                   SecurityArea
  classification         SecurityClassification
  title                  String
  description            String                 @default("")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)

  @@index([solutionArchitectureId])
  @@index([classification])
}

model ArchitectureQuestion {
  id                     String           @id @default(cuid())
  productId              String
  solutionArchitectureId String?
  question               String
  reason                 String           @default("")
  impact                 AssumptionImpact @default(MEDIUM)
  status                 QuestionStatus   @default(OPEN)
  answer                 String           @default("")
  answeredBy             String           @default("")
  createdAt              DateTime         @default(now())
  resolvedAt             DateTime?

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  architecture SolutionArchitecture? @relation(fields: [solutionArchitectureId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([solutionArchitectureId])
  @@index([status])
}

model NfrCoverage {
  id                     String   @id @default(cuid())
  solutionArchitectureId String
  nfrId                  String
  componentId            String?
  adrId                  String?
  mechanism              String   @default("")
  createdAt              DateTime @default(now())

  architecture SolutionArchitecture        @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  nfr          NonFunctionalRequirement    @relation(fields: [nfrId], references: [id], onDelete: Cascade)
  component    ArchitectureComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  adr          ArchitectureDecisionRecord? @relation(fields: [adrId], references: [id], onDelete: SetNull)

  @@index([solutionArchitectureId])
  @@index([nfrId])
}

model ComponentTrace {
  id           String   @id @default(cuid())
  componentId  String
  capabilityId String?
  workItemId   String?
  nfrId        String?
  adrId        String?
  createdAt    DateTime @default(now())

  component  ArchitectureComponent       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  capability ProductCapability?          @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  workItem   WorkItem?                   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  nfr        NonFunctionalRequirement?   @relation(fields: [nfrId], references: [id], onDelete: SetNull)
  adr        ArchitectureDecisionRecord? @relation(fields: [adrId], references: [id], onDelete: SetNull)

  @@index([componentId])
  @@index([capabilityId])
  @@index([workItemId])
}

model ImplementationPlan {
  id                     String     @id @default(cuid())
  productId              String
  productSliceId         String?
  solutionArchitectureId String
  version                Int
  status                 PlanStatus @default(DRAFT)
  summary                String     @default("")
  seededDemo             Boolean    @default(false)
  humanLocked            Boolean    @default(false)
  reviewRequired         Boolean    @default(false)
  reviewReason           String     @default("")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSlice ProductSlice?        @relation(fields: [productSliceId], references: [id], onDelete: SetNull)
  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  tasks        ImplementationTask[]
  governanceReviews EngineeringGovernanceReview[]

  @@unique([productId, version])
  @@index([productId])
  @@index([solutionArchitectureId])
  @@index([status])
}

model ImplementationTask {
  id                     String                   @id @default(cuid())
  implementationPlanId   String
  workItemId             String?
  title                  String
  description            String                   @default("")
  objective              String                   @default("")
  verticalSlice          String                   @default("")
  guidance               String                   @default("")
  validation             String                   @default("")
  risks                  String                   @default("")
  filesLikely            String                   @default("")
  sequence               Int                      @default(1)
  parallelisable         Boolean                  @default(false)
  dependenciesIdentified Boolean                  @default(false)
  status                 ImplementationTaskStatus @default(PROPOSED)
  complexity             TaskComplexity           @default(UNKNOWN)
  humanLocked            Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  plan         ImplementationPlan            @relation(fields: [implementationPlanId], references: [id], onDelete: Cascade)
  workItem     WorkItem?                     @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  components   ImplementationTaskComponent[]
  dependencies ImplementationTaskDependency[] @relation("TaskDependent")
  dependents   ImplementationTaskDependency[] @relation("TaskDependency")
  codingRisks  CodingRiskAssessment[]
  findingLinks GovernanceFindingLink[]
  workspaces   RepositoryWorkspace[]
  codingContracts CodingExecutionContract[]

  @@index([implementationPlanId])
  @@index([workItemId])
  @@index([sequence])
}

model ImplementationTaskComponent {
  id          String @id @default(cuid())
  taskId      String
  componentId String

  task      ImplementationTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  component ArchitectureComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([taskId, componentId])
  @@index([componentId])
}

model ImplementationTaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      ImplementationTask @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn ImplementationTask @relation("TaskDependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model ArchitectureProposal {
  id         String                   @id @default(cuid())
  productId  String
  agentRunId String?
  kind       ArchitectureProposalKind
  status     ProposalStatus           @default(OPEN)
  summary    String                   @default("")
  payload    Json
  seededDemo Boolean                  @default(false)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([kind, status])
}

enum GovernanceReviewStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum GovernanceAssessment {
  PASS
  PASS_WITH_ACTIONS
  BLOCKED
}

enum FindingCategory {
  SECURITY
  PRIVACY
  ARCHITECTURE
  RELIABILITY
  OBSERVABILITY
  DATA
  INTEGRATION
  TESTABILITY
  MAINTAINABILITY
  DEPENDENCY
  DELIVERY
  COMPLIANCE
  OPERABILITY
  OTHER
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  ACCEPTED
  MITIGATED
  RISK_ACCEPTED
  CLOSED
}

enum ThreatLikelihood {
  LOW
  MEDIUM
  HIGH
}

enum ThreatImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ThreatStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

enum CodingRiskLevel {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

enum CodingExecutionMode {
  AUTONOMOUS
  SUPERVISED
  HUMAN_ONLY
}

enum EvidenceType {
  AI_ANALYSIS
  HUMAN_CONFIRMATION
  TEST_RESULT
  STATIC_ANALYSIS
  DEPENDENCY_SCAN
  SECURITY_SCAN
  DOCUMENT
}

enum GovernanceTopic {
  SECURITY
  PRIVACY
  PLAN
  ARCHITECTURE
  GENERAL
}

enum GovernanceProposalSection {
  FULL
  SECURITY
  PRIVACY
  PLAN
  ARCHITECTURE
  TASK
}

model EngineeringGovernanceReview {
  id                         String                 @id @default(cuid())
  productId                  String
  solutionArchitectureId     String
  implementationPlanId       String
  version                    Int
  status                     GovernanceReviewStatus @default(DRAFT)
  overallAssessment          GovernanceAssessment
  summary                    String                 @default("")
  assistantSummary           String                 @default("")
  securityAssessment         String                 @default("")
  privacyAssessment          String                 @default("")
  engineeringAssessment      String                 @default("")
  implementationPlanAssessment String               @default("")
  dependencyReview           String                 @default("")
  readinessNote              String                 @default("")
  seededDemo                 Boolean                @default(false)
  humanLocked                Boolean                @default(false)
  reviewRequired             Boolean                @default(false)
  reviewReason               String                 @default("")
  reviewFlaggedAt            DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  architecture SolutionArchitecture @relation(fields: [solutionArchitectureId], references: [id], onDelete: Cascade)
  plan         ImplementationPlan   @relation(fields: [implementationPlanId], references: [id], onDelete: Cascade)
  findings     GovernanceFinding[]
  threats      Threat[]
  codingRisks  CodingRiskAssessment[]
  policy       CodingPolicy?
  questions    GovernanceQuestion[]
  evidence     GovernanceEvidence[]

  @@unique([productId, version])
  @@index([productId])
  @@index([solutionArchitectureId])
  @@index([implementationPlanId])
  @@index([status])
}

model GovernanceFinding {
  id               String          @id @default(cuid())
  reviewId         String
  category         FindingCategory
  severity         FindingSeverity
  title            String
  description      String          @default("")
  evidence         String          @default("")
  recommendation   String          @default("")
  status           FindingStatus   @default(OPEN)
  owner            String          @default("")
  dueBeforeCoding  Boolean         @default(false)
  rationale        String          @default("")
  humanLocked      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  review   EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  links    GovernanceFindingLink[]
  evidenceItems GovernanceEvidence[]

  @@index([reviewId])
  @@index([category])
  @@index([severity])
  @@index([status])
}

model GovernanceFindingLink {
  id            String  @id @default(cuid())
  findingId     String
  componentId   String?
  adrId         String?
  taskId        String?
  nfrId         String?
  workItemId    String?
  assumptionId  String?
  createdAt     DateTime @default(now())

  finding    GovernanceFinding           @relation(fields: [findingId], references: [id], onDelete: Cascade)
  component  ArchitectureComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  adr        ArchitectureDecisionRecord? @relation(fields: [adrId], references: [id], onDelete: SetNull)
  task       ImplementationTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  nfr        NonFunctionalRequirement?   @relation(fields: [nfrId], references: [id], onDelete: SetNull)
  workItem   WorkItem?                   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  assumption RequirementAssumption?      @relation(fields: [assumptionId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([componentId])
  @@index([adrId])
  @@index([taskId])
  @@index([nfrId])
  @@index([workItemId])
  @@index([assumptionId])
}

model Threat {
  id                   String           @id @default(cuid())
  reviewId             String
  title                String
  description          String           @default("")
  affectedComponentId  String?
  attackSurface        String           @default("")
  likelihood           ThreatLikelihood @default(MEDIUM)
  impact               ThreatImpact     @default(MEDIUM)
  mitigation           String           @default("")
  status               ThreatStatus     @default(OPEN)
  humanLocked          Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  review    EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  component ArchitectureComponent?      @relation(fields: [affectedComponentId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([affectedComponentId])
  @@index([status])
}

model CodingRiskAssessment {
  id                       String              @id @default(cuid())
  reviewId                 String
  implementationTaskId     String
  riskLevel                CodingRiskLevel
  reason                   String              @default("")
  recommendedExecutionMode CodingExecutionMode
  requiredHumanReview      Boolean             @default(false)
  overrideRiskLevel        CodingRiskLevel?
  overrideExecutionMode    CodingExecutionMode?
  overrideReason           String              @default("")
  overriddenBy             String              @default("")
  overriddenAt             DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  review EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  task   ImplementationTask           @relation(fields: [implementationTaskId], references: [id], onDelete: Cascade)

  @@unique([reviewId, implementationTaskId])
  @@index([implementationTaskId])
  @@index([riskLevel])
}

model CodingPolicy {
  id                   String    @id @default(cuid())
  productId            String
  reviewId             String    @unique
  allowedPaths         Json      @default("[]")
  restrictedPaths      Json      @default("[]")
  prohibitedActions    Json      @default("[]")
  requiredChecks       Json      @default("[]")
  maxFilesPerTask      Int?
  requireTests         Boolean   @default(true)
  requireHumanReview   Boolean   @default(true)
  humanLocked          Boolean   @default(false)
  reapprovalRequired   Boolean   @default(false)
  reapprovalReason     String    @default("")
  reapprovalFlaggedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  product Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  review  EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model GovernanceEvidence {
  id          String       @id @default(cuid())
  reviewId    String
  findingId   String?
  type        EvidenceType
  source      String       @default("")
  description String       @default("")
  result      String       @default("")
  createdAt   DateTime     @default(now())

  review  EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  finding GovernanceFinding?          @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([findingId])
  @@index([type])
}

model GovernanceQuestion {
  id         String           @id @default(cuid())
  reviewId   String
  question   String
  reason     String           @default("")
  impact     AssumptionImpact @default(MEDIUM)
  topic      GovernanceTopic  @default(GENERAL)
  blocking   Boolean          @default(false)
  status     QuestionStatus   @default(OPEN)
  answer     String           @default("")
  answeredBy String           @default("")
  humanLocked Boolean         @default(false)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  review EngineeringGovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([status])
  @@index([blocking])
}

model GovernanceProposal {
  id         String                     @id @default(cuid())
  productId  String
  agentRunId String?
  section    GovernanceProposalSection  @default(FULL)
  taskRef    String                     @default("")
  status     ProposalStatus             @default(OPEN)
  summary    String                     @default("")
  payload    Json
  seededDemo Boolean                    @default(false)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([section, status])
}

enum RepositoryProvider {
  LOCAL
  GITHUB_FUTURE
}

enum RepositoryRecordStatus {
  CONFIGURED
  UNAVAILABLE
  DISABLED
}

enum WorkspaceStatus {
  CREATING
  ACTIVE
  CHECKING
  READY_FOR_REVIEW
  FAILED
  ABANDONED
  COMPLETED
}

enum ExecutionContractStatus {
  DRAFT
  APPROVED
  EXECUTING
  COMPLETED
  FAILED
  ESCALATED
}

enum ExecutionPlanStatus {
  PROPOSED
  APPROVED
  EXECUTING
  COMPLETED
  ESCALATED
}

enum CodingEscalationType {
  REQUIREMENT_AMBIGUITY
  ARCHITECTURE_CONFLICT
  MISSING_DEPENDENCY
  POLICY_CONFLICT
  SCOPE_EXPANSION
  TEST_FAILURE
  SECURITY_CONCERN
  UNEXPECTED_CODEBASE
  OTHER
}

enum CodingEscalationStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum CodingEvidenceType {
  FILE_CHANGE
  TEST_RESULT
  TYPECHECK
  LINT
  BUILD
  STATIC_ANALYSIS
  AGENT_ANALYSIS
  HUMAN_CONFIRMATION
}

enum CodingEvidenceSource {
  REPOSITORY
  COMMAND_RUNNER
  AI_ANALYSIS
  HUMAN
}

enum CodingToolAction {
  READ_FILE
  LIST_DIRECTORY
  WRITE_FILE
  CREATE_FILE
  DELETE_FILE
  RUN_COMMAND
  GET_DIFF
  GET_STATUS
}

model Repository {
  id             String                 @id @default(cuid())
  productId      String
  name           String
  provider       RepositoryProvider     @default(LOCAL)
  repositoryUrl  String                 @default("")
  defaultBranch  String                 @default("main")
  localPath      String
  status         RepositoryRecordStatus @default(UNAVAILABLE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspaces RepositoryWorkspace[]

  @@unique([productId])
  @@index([status])
}

model RepositoryWorkspace {
  id                     String          @id @default(cuid())
  repositoryId           String
  productId              String
  implementationTaskId   String
  agentRunId             String?
  workspacePath          String
  branchName             String
  baseCommit             String          @default("")
  headCommit             String          @default("")
  status                 WorkspaceStatus @default(CREATING)
  executionContractStale Boolean         @default(false)
  staleReason            String          @default("")
  staleFlaggedAt         DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  completedAt            DateTime?

  repository Repository              @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  task       ImplementationTask      @relation(fields: [implementationTaskId], references: [id], onDelete: Cascade)
  contract   CodingExecutionContract?
  plan       CodingExecutionPlan?
  escalations CodingEscalation[]
  evidence   CodingEvidence[]
  toolEvents CodingToolEvent[]
  selfReview CodingSelfReview?
  revisions  CodingRevision[]
  diff       CodingDiff?
  codeApprovals CodeChangeApproval[]

  @@index([productId, status])
  @@index([repositoryId])
  @@index([implementationTaskId])
}

model CodingExecutionContract {
  id                       String                  @id @default(cuid())
  implementationTaskId     String
  workspaceId              String                  @unique
  objective                String                  @default("")
  allowedPaths             Json                    @default("[]")
  restrictedPaths          Json                    @default("[]")
  acceptanceCriteria       Json                    @default("[]")
  requiredChecks           Json                    @default("[]")
  architectureConstraints  String                  @default("")
  codingPolicyConstraints  String                  @default("")
  dependencies             Json                    @default("[]")
  validationExpectations   String                  @default("")
  maxFiles                 Int?
  executionMode            CodingExecutionMode
  riskLevel                CodingRiskLevel
  allowFileDelete          Boolean                 @default(false)
  status                   ExecutionContractStatus @default(APPROVED)
  sourceFingerprint        String                  @default("")
  stale                    Boolean                 @default(false)
  staleReason              String                  @default("")
  staleFlaggedAt           DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  task      ImplementationTask   @relation(fields: [implementationTaskId], references: [id], onDelete: Cascade)
  workspace RepositoryWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([implementationTaskId])
  @@index([status])
}

model CodingExecutionPlan {
  id                   String              @id @default(cuid())
  workspaceId          String              @unique
  summary              String              @default("")
  analysisNote         String              @default("")
  filesExpectedToChange Json               @default("[]")
  steps                Json                @default("[]")
  risks                String              @default("")
  validationPlan       String              @default("")
  status               ExecutionPlanStatus @default(PROPOSED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CodingEscalation {
  id                 String                 @id @default(cuid())
  workspaceId        String
  type               CodingEscalationType
  description        String                 @default("")
  reason             String                 @default("")
  recommendedAction  String                 @default("")
  status             CodingEscalationStatus @default(OPEN)
  createdAt          DateTime               @default(now())
  resolvedAt         DateTime?

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([type])
}

model CodingEvidence {
  id                   String              @id @default(cuid())
  workspaceId          String
  implementationTaskId String
  type                 CodingEvidenceType
  source               CodingEvidenceSource
  description          String              @default("")
  result               String              @default("")
  command              String              @default("")
  exitCode             Int?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([implementationTaskId])
  @@index([type])
}

model CodingToolEvent {
  id          String           @id @default(cuid())
  workspaceId String
  action      CodingToolAction
  allowed     Boolean
  reason      String           @default("")
  path        String           @default("")
  command     String           @default("")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([allowed])
}

model CodingSelfReview {
  id         String   @id @default(cuid())
  workspaceId String  @unique
  summary    String   @default("")
  findings   Json     @default("{}")
  createdAt  DateTime @default(now())

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CodingRevision {
  id              String   @id @default(cuid())
  workspaceId     String
  feedback        String   @default("")
  requiredChanges String   @default("")
  affectedFiles   Json     @default("[]")
  createdAt       DateTime @default(now())

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CodingDiff {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  files         Json     @default("[]")
  additions     Int      @default(0)
  deletions     Int      @default(0)
  patch         String   @default("")
  truncated     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CodeChangeApproval {
  id                   String    @id @default(cuid())
  productId            String
  approvalId           String
  implementationTaskId String
  workspaceId          String
  baseCommit           String
  headCommit           String
  diffHash             String
  stale                Boolean   @default(false)
  staleReason          String    @default("")
  staleFlaggedAt       DateTime?
  createdAt            DateTime  @default(now())

  approval  Approval             @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workspace RepositoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([workspaceId])
  @@index([implementationTaskId])
}
