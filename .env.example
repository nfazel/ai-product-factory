# PostgreSQL connection used by Prisma and the Next.js server.
# Copy this file to .env and adjust the credentials for your machine.
DATABASE_URL="postgresql://apf:apf_dev_password@127.0.0.1:5432/ai_product_factory?schema=public"

# Server-side only. Never expose this to the browser.
# Leave it empty to run the app without model calls. Discovery then shows that AI is not configured and does not invent a response.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini when Product Discovery runs.
# OPENAI_MODEL=gpt-4.1-mini
