# PostgreSQL connection used by Prisma and the Next.js server.
# Copy this file to .env and adjust the credentials for your machine.
# The test suite never uses the database above. It gets its own, named like it with _test added (ai_product_factory_test),
# created and migrated automatically on the first run. Set this only to choose a different one; its name must end in _test.
# TEST_DATABASE_URL=
DATABASE_URL="postgresql://apf:apf_dev_password@127.0.0.1:5432/ai_product_factory?schema=public"

# AI Product Builder AI configuration.
# One active provider and model. Empty does not assume Gemini, Ollama, or OpenAI.
# Settings can store the provider and model.
# Supported providers: GOOGLE_GEMINI, OLLAMA, OPENAI
AI_PROVIDER=
AI_MODEL=

# Encrypts Gemini and OpenAI API keys saved in Settings. 32 bytes, base64 or hex.
# Generate with: openssl rand -base64 32
# Do not commit a real value. The server never sends this to the browser.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Optional server-only credentials. Used when Settings has no saved key for that provider.
# Never put these in NEXT_PUBLIC_ variables or in the browser.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama does not need an API key for normal local use.
# The server reads this address. The browser cannot set it per request.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional. When set, Build can read this directory's package.json and top-level folders.
# The application does not accept an arbitrary path from the browser and does not clone repositories.
# CODEBASE_CONTEXT_ROOT=

# Local Git repository the Coding Agent may use. This is not read from the browser.
# Point it at a separate demo repository, not this application's source, unless you set the flag below.
# PRODUCT_REPOSITORY_ROOT=
# PRODUCT_WORKSPACE_ROOT=
# PRODUCT_REPOSITORY_ALLOW_FACTORY=true
# Optional directory for isolated Git worktrees. Defaults to a folder under the system temp directory.
# PRODUCT_REPOSITORY_WORKTREE_ROOT=

# GitHub publication. Optional server fallback. Settings can store a GitHub App or a fine-grained personal access token.
# Stored credentials are encrypted with AI_CREDENTIAL_ENCRYPTION_KEY and are not returned to the browser.
# A connection is CONNECTED only after Validate connection succeeds.
# Prefer a GitHub App. GITHUB_TOKEN remains a server fallback when Settings has no saved credential.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPOSITORY=
# GITHUB_MINIMUM_HUMAN_APPROVALS=1
# GITHUB_SERVICE_ACCOUNT=

# Optional local operator external-review authorization; random >=32-byte secret.
# Never expose this key to product commands or public endpoints.
EXTERNAL_REVIEW_APPROVAL_KEY=""
# Set to "off" for a local proof of concept to skip typing the operator credential. The key above is still required
# and is used by the server; the decision is recorded from the local human's click. Leave unset to require the credential.
# OPERATOR_CONFIRMATION=off

# Local development only: do not tie runtime reviews to the version of the framework's own code, so editing the
# framework does not void earlier approvals. Reviews still bind the commit, plan, code approval and signature.
# Leave unset for full checking; turn it off again before relying on approvals for a release.
# APF_RUNTIME_IDENTITY=off

# Keep disabled until container integration validation and runtime approval pass.
# There is no native verification fallback.
APF_CONTAINER_VERIFICATION_READY=0
